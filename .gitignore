# Godot 4+ specific ignores
.godot/
/android/
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System / editor files
.DS_Store
Thumbs.db

# tools/geo_bake: offline terrain-data bake pipeline (tools/geo_bake/*.py
# themselves ARE committed — reproducible, unlike the earlier ephemeral
# coastline-bake script). Its downloaded OSM/elevation cache and run logs
# are large (1.8GB+ for a full corridor bake), regenerable, and specific
# to whoever last ran it — never commit them. The two actual OUTPUT
# assets (assets/terrain_data/*.png) ARE committed, same as any other
# baked game asset.
tools/geo_bake/cache/
tools/geo_bake/*.log

# Python bytecode from the geo_bake and blender_pipeline scripts. The
# blender_pipeline caches were tracked until now and re-churned on every
# render; they are per-interpreter-version build output, not source.
__pycache__/

# Claude Code's session state: local permission settings and, more
# importantly, .claude/worktrees/ — full checkouts of this repo, each with
# its own .git. Committing that nests a repository inside itself. The agent
# definitions and slash commands are shared project tooling, so they stay tracked.
.claude/*
!.claude/agents/
!.claude/commands/

# Diagnostic images written by the relief tooling (preview_relief.gd,
# compare_relief_slope.py, the tile stitcher). Regenerated on demand and only
# meaningful while tuning the bake constants -- the tools are the artefact, not
# their output.
tools/geo_bake/*_preview.png
tools/geo_bake/*_comparison.png
tools/geo_bake/*_preview.png.import
tools/geo_bake/*_comparison.png.import
